# Secrets — never committed. deploy/ holds the generated production config
# (live DB credentials + admin hash) and the FTP account (deploy/ftp.php).
deploy/

# Local dev config carries the local DB password; the production one is
# generated by data/setup.php and lives in deploy/ anyway.
config.php

# Local state, data and logs
storage/
backups/
public/storage/
*.log

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Design-time tooling, not part of the app. Reinstall: git clone --depth 1 https://github.com/tt-a1i/archify /tmp/a && cp -r /tmp/a/archify tools/archify
tools/archify/
