  "cards": [
    {
      "dot": "emerald",
      "title": "One Chain",
      "items": [
        "Estimate is the quote \u2014 no separate quote entity",
        "Lines live once in doc_lines and promote EST \u2192 WO \u2192 INV",
        "Authorization is the only human gate before work"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing Deleted",
      "items": [
        "Estimates are superseded, never edited after authorization",
        "Invoices are voided or credited, then re-issued",
        "audit_log and api_log are append-only"
      ]
    },
    {
      "dot": "cyan",
      "title": "Money Rules",
      "items": [
        "Cost, markup % and price snapshot onto each line",
        "Tax is per line, never subtotal \u00d7 rate",
