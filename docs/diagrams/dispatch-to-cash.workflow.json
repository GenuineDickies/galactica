{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Dispatch-to-Cash Chain",
    "output": "docs/diagrams/dispatch-to-cash.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "quote",
        "label": "Request to authorized estimate",
        "focus": [
          "request",
          "estimate",
          "authorize"
        ],
        "note": "The Estimate is the quote. Nothing is priced twice; lines snapshot cost and markup at authorization."
      },
      {
        "id": "work",
        "label": "Work order to invoice",
        "focus": [
          "authorize",
          "work_order",
          "invoice"
        ],
        "note": "Lines promote EST \u2192 WO \u2192 INV inside one doc_lines table; editing the markup matrix never changes an issued document."
      },
      {
        "id": "cash",
        "label": "Payment, receipt, ledger",
        "focus": [
          "invoice",
          "payment",
          "receipt",
          "ledger"
        ],
        "note": "Every payment posts a balanced journal entry; the receipt is the customer-facing echo of that posting."
      },
      {
        "id": "exceptions",
        "label": "Voids and supersedes",
        "focus": [
          "estimate",
          "superseded",
          "invoice",
          "void_credit"
        ],
        "note": "Nothing is deleted. A replaced estimate is superseded; a wrong invoice is voided or credited and re-issued."
      }
    ]
  },
  "lanes": [
    {
      "id": "customer",
      "label": "Customer"
    },
